# ==============================================================================
# KinGuard Environment Template
# Copy to `.local.env` (or `.env`) and fill the values you need.
# Never commit `.local.env`, `.env`, or service-account JSON files.
# ==============================================================================

# ---- 1. PRIMARY: Firebase AI Logic (Hybrid Nano + Cloud Fallback) & App Check
# Browser-public Firebase web app settings, served via GET /api/firebase-config.
# Setup: Firebase Console -> Project Settings -> Web App, and enable AI Logic.
KINGUARD_FIREBASE_API_KEY=
KINGUARD_FIREBASE_AUTH_DOMAIN=
KINGUARD_FIREBASE_PROJECT_ID=
KINGUARD_FIREBASE_STORAGE_BUCKET=
KINGUARD_FIREBASE_MESSAGING_SENDER_ID=
KINGUARD_FIREBASE_APP_ID=
KINGUARD_FIREBASE_MODEL=gemini-2.5-flash
# Production web App Check (reCAPTCHA Enterprise site key):
KINGUARD_FIREBASE_RECAPTCHA_SITE_KEY=
# Local testing only: set `true` and register the console debug UUID in Firebase App Check:
KINGUARD_FIREBASE_APPCHECK_DEBUG=false

# ---- 2. PRIMARY: Gemini / Vertex AI / Google Cloud (ADK & Backend Models) ---
# Option A (Vertex AI - recommended for GCP/Cloud Run): set TRUE + project + ADC
# Option B (Gemini Developer API key locally): set FALSE + GEMINI_API_KEY below
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=kinguard-hack
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_QUOTA_PROJECT=kinguard-hack
# Optional service-account JSON path when not using `gcloud auth application-default login`:
# GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GOOGLE_API_KEY=
KINGUARD_MODEL=gemini-3.5-flash
KINGUARD_DETECT_MODEL=gemini-2.5-flash-lite

# ---- 3. PRIMARY: Authentication, Sessions & Signed Handoff Links -----------
# Demo dashboard bearer credential (matches web UI button by default):
KINGUARD_DEMO_TOKEN=kinguard-demo-family-token
# Google Sign-In Web OAuth Client ID (public ID only; ID token verified server-side):
KINGUARD_GOOGLE_CLIENT_ID=
# Required for signing 24h family alert links, 1h /handoff/{token}, & clinician codes.
# Generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KINGUARD_LINK_SECRET=
# Ed25519 private key (PKCS#8 PEM base64). Mint via: uv run python -m kinguard.provenance.keygen
KINGUARD_SIGNING_KEY_B64=
# Optional comma-separated historical Ed25519 public keys trusted by verify_chain:
KINGUARD_TRUSTED_PUBLIC_KEYS=

# ---- 4. PRIMARY: Server, Public URLs & Storage Backend -----------------------
PORT=8080
# Set to "memory" for zero-GCP local testing, or "firestore" for Firestore/Emulator:
KINGUARD_STORE_BACKEND=firestore
KINGUARD_FIRESTORE_DATABASE=(default)
# Leave commented unless running local Firestore emulator (e.g. 127.0.0.1:8080):
# FIRESTORE_EMULATOR_HOST=
# Public origin URL used in QR codes, shortlinks, webhooks, & WhatsApp templates:
KINGUARD_PUBLIC_BASE_URL=
KINGUARD_DASHBOARD_URL=
KINGUARD_URL=http://127.0.0.1:8080
KINGUARD_SERVE_DEV_UI=true

# ---- 5. OPTIONAL: Cloud Storage, Pub/Sub & Agent Engine Memory Bank ----------
# Private GCS bucket for photographed bills/labs/PDFs & booking screenshots:
KINGUARD_ARTIFACT_BUCKET=
# Needed only when signing V4 URLs locally with ADC lacking a private key:
KINGUARD_SIGNER_SERVICE_ACCOUNT=
KINGUARD_PUBSUB_ENABLED=false
KINGUARD_TOPIC_INTAKE=kinguard-intake-events
KINGUARD_TOPIC_CASE_UPDATES=kinguard-case-updates
KINGUARD_TOPIC_CLAIM_STATUS=kinguard-claim-status
# Reasoning Engine resource: projects/<num>/locations/asia-south1/reasoningEngines/<id>
KINGUARD_MEMORY_BANK=
KINGUARD_MEMORY_BANK_LIVE=
# Optional ADK persistent URIs (e.g. agentengine://... or db URI):
KINGUARD_MEMORY_SERVICE_URI=
KINGUARD_SESSION_SERVICE_URI=

# ---- 6. OPTIONAL: Google Maps & Places (Routing Map + Live Lab Lookup) -------
# Browser Maps JS API key (HTTP-referrer restricted):
KINGUARD_MAPS_API_KEY=
# seeded | places
KINGUARD_DIAGNOSTICS_MODE=seeded
# Server-side Google Places API key (used when KINGUARD_DIAGNOSTICS_MODE=places):
KINGUARD_PLACES_API_KEY=

# ---- 7. OPTIONAL: Payments (Razorpay Collections & RazorpayX Payouts) --------
# simulated | razorpay | razorpayx | payout | off
KINGUARD_PAYMENT_MODE=simulated
# Safety check in code enforces rzp_test_ prefix (never live keys):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# ---- 8. OPTIONAL: WhatsApp & Voice Escalation (Twilio Sandbox / Meta Cloud) --
# off | twilio | meta
KINGUARD_WHATSAPP_MODE=off
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Voice calls (off | twilio; requires purchased Twilio number, never sandbox):
KINGUARD_VOICE_MODE=off
TWILIO_VOICE_FROM=
# Meta Cloud API (alternative when KINGUARD_WHATSAPP_MODE=meta):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0

# ---- 9. OPTIONAL: Backend Gemini Vision / Voice / Language Switches ----------
KINGUARD_BILL_VISION_MODE=gemini
KINGUARD_DOC_VISION_MODE=gemini
KINGUARD_TRANSCRIBE_MODE=gemini
KINGUARD_DICTATION_MODE=gemini
KINGUARD_TRANSLATE_MODE=gemini
KINGUARD_DETECT_LANGUAGE_MODE=gemini

# ---- 10. OPTIONAL: TPA Liaison & Playwright Clinic Booker Microservice -------
KINGUARD_TPA_MODE=simulated
KINGUARD_TPA_ENDPOINT=
KINGUARD_BOOKER_URL=
KINGUARD_BOOKING_CHANNELS=web
KINGUARD_BOOKING_DRYRUN=1
KINGUARD_BOOKING_READER=gemini
KINGUARD_BOOKING_IGNORE_ROBOTS=false
KINGUARD_BOOKING_UA=
KINGUARD_BOOKING_ALLOW_PRIVATE=0

# ---- 11. OPTIONAL: Recovery Cadence, Public Sandbox & Demo Seed Data ---------
KINGUARD_RECOVERY_WINDOW_DAYS=14
KINGUARD_RECOVERY_HOUR=9
KINGUARD_RECOVERY_TIMEZONE=Asia/Kolkata
KINGUARD_SANDBOX=off
KINGUARD_SANDBOX_DAILY_CAP=25
KINGUARD_SANDBOX_TTL_HOURS=24
KINGUARD_DEMO_FAMILY_NAME=Nishant Maurya
KINGUARD_DEMO_FAMILY_EMAIL=
KINGUARD_DEMO_FAMILY_E164=
KINGUARD_DEMO_FAMILY_LANGUAGE=en
KINGUARD_DEMO_FAMILY_TZ=America/Los_Angeles
KINGUARD_DEMO_PARENT_E164=
KINGUARD_DEMO_PARENT_LANGUAGE=ta
KINGUARD_DEMO_CIRCLE_NAME=Meena
KINGUARD_DEMO_CIRCLE_E164=
KINGUARD_DEMO_CIRCLE_LANGUAGE=ta
KINGUARD_DEMO_ROLE_TAGS=off

# ---- 12. OPTIONAL: Cloud Run Deploy & Scheduler Script Parameters ------------
KINGUARD_REGION=asia-south1
KINGUARD_SERVICE=kinguard
KINGUARD_SCHEDULER_LOCATION=asia-south1
KINGUARD_SCHEDULER_JOB=kinguard-recovery-tick
KINGUARD_CLAIMS_SCHEDULER_JOB=kinguard-claims-sla-tick
KINGUARD_BREACH_PARENT=
